# Copy to monitoring/.env on the server and fill in. Do not commit the real file.
#
# Set each version to what is CURRENTLY running so the pin doesn't downgrade the
# existing Grafana/Prometheus data volumes (a downgrade can fail to start):
#   docker exec grafana grafana --version
#   docker exec prometheus prometheus --version
#   docker exec node-exporter node_exporter --version
GRAFANA_VERSION=
PROMETHEUS_VERSION=
NODE_EXPORTER_VERSION=
GRAFANA_ADMIN_PASSWORD=
